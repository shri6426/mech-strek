# ─────────────────────────────────────────────────────
# MechOS API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# Application
PORT=8000
ENVIRONMENT=development   # development | production

# ─── PostgreSQL (Supabase or self-hosted) ─────────────
DATABASE_URL=postgresql+asyncpg://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:6543/postgres

# Individual Postgres components (used by alembic and scripts)
POSTGRES_SERVER=db.xxxxxxxxxxxxxxxx.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=postgres
POSTGRES_PORT=6543

# ─── JWT / Auth ───────────────────────────────────────
SECRET_KEY=your_super_secret_jwt_key_here_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Admin Setup ──────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL=admin@yourcompany.com

# ─── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OAuth (optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Payment Gateways (optional) ──────────────────────
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── AI (optional) ────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key
