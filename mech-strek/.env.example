# ─────────────────────────────────────────────────────
# mech-strek — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────

# Backend API URL (must point to your running mechos-api instance)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket URL (same host as API, but ws:// protocol)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1

# OAuth Config (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Payment Keys (Optional — public/publishable keys only)
NEXT_PUBLIC_STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxxxxxxxxxx
